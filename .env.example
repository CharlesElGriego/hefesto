# Required — your Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# Optional — model used for extraction/conversation (defaults to Haiku 4.5)
# ANTHROPIC_MODEL=claude-haiku-4-5

# Optional — host port for the app (change it if 3000 is taken)
# APP_PORT=3000

# Optional — WhatsApp numbers (besides the linked account's self-chat) allowed
# to talk to Hefesto, comma-separated with country code. Empty = self-chat only.
# WHATSAPP_ALLOWED_NUMBERS=50688881111,584121234567

# Optional — only needed when running the backend outside Docker
# MONGO_URI=mongodb://localhost:27017/hefesto
# PORT=3000
